diff --git a/codex-rs/tui/src/history_cell/assistant_images.rs b/codex-rs/tui/src/history_cell/assistant_images.rs
new file mode 100644
index 0000000..0c960f8
--- /dev/null
+++ b/codex-rs/tui/src/history_cell/assistant_images.rs
@@ -0,0 +1,104 @@
+//! Completed assistant replies preview linked local raster artifacts below their text.
+//! Markdown parsing excludes code examples. Remote URLs never trigger network requests.
+
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pulldown_cmark::Event;
+use pulldown_cmark::Parser;
+use pulldown_cmark::Tag;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub(super) fn local_paths(markdown: &str, cwd: &Path) -> Vec<AbsolutePathBuf> {
+    let mut paths = Vec::new();
+    for event in Parser::new(markdown) {
+        let dest_url = match event {
+            Event::Start(Tag::Link { dest_url, .. } | Tag::Image { dest_url, .. }) => dest_url,
+            Event::Code(path) => path,
+            _ => continue,
+        };
+        let destination = dest_url.as_ref();
+        if destination.len() > 8192 || destination.chars().any(char::is_control) {
+            continue;
+        }
+        if ["//", "\\\\", "~"]
+            .iter()
+            .any(|prefix| destination.starts_with(prefix))
+        {
+            continue;
+        }
+        let raw_path = PathBuf::from(destination);
+        let candidate = if raw_path.is_absolute() {
+            raw_path
+        } else if let Ok(url) = url::Url::parse(destination) {
+            if url.scheme() != "file"
+                || url.host().is_some()
+                || url.query().is_some()
+                || url.fragment().is_some()
+            {
+                continue;
+            }
+            let Ok(path) = url.to_file_path() else {
+                continue;
+            };
+            path
+        } else {
+            let path = PathBuf::from(destination);
+            // Do not contact network shares or guess a shell/home expansion.
+            if path.is_absolute() {
+                path
+            } else {
+                cwd.join(path)
+            }
+        };
+        if crate::terminal_hyperlinks::TerminalHyperlink::viewed_image(0..0, &candidate).is_none() {
+            continue;
+        }
+        let Ok(path) = candidate
+            .canonicalize()
+            .and_then(|path| AbsolutePathBuf::try_from(path).map_err(std::io::Error::other))
+        else {
+            continue;
+        };
+        if !paths.contains(&path) {
+            paths.push(path);
+        }
+        if paths.len() == 8 {
+            break;
+        }
+    }
+    paths
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reply_links_resolve_in_message_cwd_and_skip_examples_remote_and_invalid_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let first = dir.path().join("first #1.png");
+        let second = dir.path().join("second.png");
+        image::RgbaImage::new(4, 2).save(&first).unwrap();
+        image::RgbaImage::new(2, 4).save(&second).unwrap();
+        std::fs::write(dir.path().join("notes.txt"), "text").unwrap();
+        let markdown = format!(
+            "![first](<first #1.png>) [duplicate]({}) [second](second.png)\n\
+             `[example](second.png)`\n```md\n![example](second.png)\n```\n\
+             [remote](https://example.com/image.png) [missing](missing.png) [notes](notes.txt)",
+            url::Url::from_file_path(&first).unwrap()
+        );
+        let paths = local_paths(&markdown, dir.path());
+        assert_eq!(paths.len(), 2);
+        assert_eq!(paths[0].as_path(), first.canonicalize().unwrap());
+        assert_eq!(paths[1].as_path(), second.canonicalize().unwrap());
+        assert!(
+            local_paths(
+                "`![example](second.png)`\n```md\n[x](second.png)\n```",
+                dir.path()
+            )
+            .is_empty()
+        );
+        assert_eq!(local_paths("Output: `second.png`", dir.path()).len(), 1);
+        assert!(local_paths("```\nsecond.png\n```", dir.path()).is_empty());
+    }
+}
