+#[test]
+fn assistant_reply_images_render_without_tool_expansion_and_clip_independently() {
+    let dir = tempfile::tempdir().unwrap();
+    for name in ["one.png", "two.png"] {
+        image::RgbaImage::from_pixel(400, 160, image::Rgba([12, 34, 56, 255]))
+            .save(dir.path().join(name))
+            .unwrap();
+    }
+    let markdown = "Here are the results: [one](one.png) ![two](two.png)";
+    let cell = Arc::new(crate::history_cell::AgentMarkdownCell::new(
+        markdown.into(),
+        dir.path(),
+    ));
+    assert_eq!(cell.copy_source(), Some(markdown));
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![cell];
+    let area = Rect::new(3, 2, 80, 30);
+    let mut view = TranscriptView::default();
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer, &cells);
+    let text = view.layout(&cells, 0).unwrap().text().to_owned();
+    assert!(view.image_placements().is_empty());
+    view.image_protocol = Some(crate::pets::ImageProtocol::Kitty);
+    view.render(area, &mut buffer, &cells);
+    let layout = view.layout(&cells, 0).unwrap();
+    assert_eq!(layout.text(), text);
+    assert_eq!(layout.additional_images.len(), 1);
+    let placements = view.image_placements();
+    assert_eq!(placements.len(), 2);
+    assert!(placements[0].area.bottom() <= placements[1].area.top());
+    for placement in &placements {
+        assert!(placement.area.bottom() <= area.bottom());
+        assert!(
+            buffer[(placement.area.x, placement.area.y)]
+                .symbol()
+                .contains("#codex-image-original")
+        );
+    }
+    let image_rows = placements
+        .iter()
+        .map(|p| usize::from(p.area.height))
+        .sum::<usize>();
+    assert_eq!(layout.row_count(), layout.text_row_count() + image_rows);
+    let narrow = layout.rewrap(2);
+    assert!(narrow.visible_image().is_none());
+    assert_eq!(narrow.rewrap(area.width).row_count(), layout.row_count());
+    let short = Rect::new(7, 5, 80, 3);
+    view.jump_to_latest();
+    view.render(short, &mut Buffer::empty(short), &cells);
+    assert!(!view.image_placements().is_empty());
+    assert!(view.image_placements().iter().all(|p| p.area.y >= short.y
+        && p.area.bottom() <= short.bottom()
+        && p.first_row < usize::from(p.image.rows)
+        && usize::from(p.area.height) + p.first_row <= usize::from(p.image.rows)));
+    view.set_presentation(false, HistoryRenderMode::Raw);
+    view.render(area, &mut Buffer::empty(area), &cells);
+    assert!(view.image_placements().is_empty());
+}
