+mod tests {
+    use super::*;
+
+    #[test]
+    fn original_reference_stays_on_thumbnail_cells_and_out_of_draft() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("original #1.png");
+        RgbaImage::from_pixel(800, 400, Rgba([12, 34, 56, 255]))
+            .save(&path)
+            .unwrap();
+        let attachments = [LocalImageAttachment {
+            placeholder: "[Image #1]".into(),
+            path: path.clone(),
+        }];
+        let mut textarea = TextArea::new();
+        textarea.set_text_clearing_elements("[Image #1] inspect this screenshot");
+        let mut previews = ComposerImages::for_terminal(ImageProtocol::Kitty, None).unwrap();
+        previews.original_links = true;
+        let area = Rect::new(0, 0, 20, HEIGHT + 1);
+        let mut buffer = Buffer::empty(area);
+        previews.render(area, &mut buffer, &attachments, &textarea);
+        let destination = original_image_destination(&path).unwrap();
+        assert!(destination.contains("%23"));
+        assert!(destination.ends_with("#codex-image-original"));
+        for y in 0..HEIGHT {
+            for x in 0..WIDTH {
+                assert!(buffer[(x, y)].symbol().contains(&destination));
+            }
+        }
+        assert_eq!(buffer[(WIDTH, 0)].symbol(), " ");
+        assert_eq!(buffer[(0, HEIGHT)].symbol(), " ");
+        assert_eq!(textarea.text(), "[Image #1] inspect this screenshot");
+        let placements = previews.placements.borrow();
+        assert_eq!(placements.len(), 1);
+        assert!(placements[0].image.pixels.width() <= 384);
+        assert!(placements[0].image.pixels.height() <= 160);
+    }
+
+    #[test]
+    fn normal_terminals_and_non_images_do_not_get_original_references() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("image.png");
+        RgbaImage::from_pixel(16, 8, Rgba([1, 2, 3, 255]))
+            .save(&path)
+            .unwrap();
+        let attachments = [LocalImageAttachment {
+            placeholder: "[Image #1]".into(),
+            path,
+        }];
+        let mut previews = ComposerImages::for_terminal(ImageProtocol::Kitty, None).unwrap();
+        previews.original_links = false;
+        let area = Rect::new(0, 0, 20, HEIGHT + 1);
+        let mut buffer = Buffer::empty(area);
+        previews.render(area, &mut buffer, &attachments, &TextArea::new());
+        assert!(!buffer[(0, 0)].symbol().contains("\x1b]8"));
+        let text = directory.path().join("document.txt");
+        std::fs::write(&text, "not an image").unwrap();
+        assert!(original_image_destination(&text).is_none());
+        assert!(original_image_destination(&directory.path().join("missing.png")).is_none());
+    }
