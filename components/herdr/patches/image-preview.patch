diff --git a/src/terminal/image_preview.rs b/src/terminal/image_preview.rs
new file mode 100644
index 0000000..b6efe28
--- /dev/null
+++ b/src/terminal/image_preview.rs
@@ -0,0 +1,354 @@
+//! Inspect an image drawn by a terminal, without sending input to its program.
+
+use gpui::*;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+mod original;
+pub(super) use original::OriginalSource;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Detail { Image, Loading, Original, Unavailable }
+
+#[derive(Clone, Copy)]
+enum Zoom { Fit, Actual, In, Out }
+
+struct ImagePreview {
+    image: Arc<RenderImage>,
+    focus: FocusHandle,
+    detail: Detail,
+    zoom: Option<f32>,
+    scroll: ScrollHandle,
+    pan_start: Option<(Point<Pixels>, Point<Pixels>)>,
+    cancelled: Arc<AtomicBool>,
+    _loading: Option<Task<()>>,
+    _parent_close: Subscription,
+}
+
+#[cfg(test)]
+pub(super) fn open(image: Arc<RenderImage>, parent: &Window, cx: &mut App) -> anyhow::Result<()> {
+    open_original(image, None, parent, cx)
+}
+
+pub(super) fn open_original(image: Arc<RenderImage>, original: Option<OriginalSource>, parent: &Window, cx: &mut App) -> anyhow::Result<()> {
+    let parent_id = parent.window_handle().window_id();
+    let display = parent.display(cx);
+    let available = display.as_ref().map_or(parent.viewport_size(), |display| display.bounds().size);
+    let preview_size = size((available.width * 0.9).min(px(1000.0)), (available.height * 0.9).min(px(760.0)));
+    let display = display.map(|display| display.id());
+    let bounds = Bounds::centered(display, preview_size, cx);
+    cx.open_window(
+        WindowOptions {
+            window_bounds: Some(WindowBounds::Windowed(bounds)),
+            display_id: display,
+            titlebar: Some(TitlebarOptions { title: Some("Image preview — Esc to close".into()), ..Default::default() }),
+            ..Default::default()
+        },
+        |window, cx| cx.new(|cx| {
+            let focus = cx.focus_handle();
+            focus.focus(window, cx);
+            let preview = window.window_handle();
+            let parent_close = cx.on_window_closed(move |cx, closed| {
+                if closed == parent_id {
+                    let _ = preview.update(cx, |_, window, _| window.remove_window());
+                }
+            });
+            let mut preview = ImagePreview { image, focus, detail: Detail::Image, zoom: None,
+                scroll: ScrollHandle::new(), pan_start: None, cancelled: Arc::new(AtomicBool::new(false)),
+                _loading: None, _parent_close: parent_close };
+            if let Some(original) = original { preview.load_original(original, cx); }
+            preview
+        }),
+    )?;
+    Ok(())
+}
+
+impl Drop for ImagePreview {
+    fn drop(&mut self) { self.cancelled.store(true, Ordering::Relaxed); }
+}
+
+impl ImagePreview {
+    fn load_original(&mut self, original: OriginalSource, cx: &mut Context<Self>) {
+        self.detail = Detail::Loading;
+        let cancelled = self.cancelled.clone();
+        let work = cx.background_executor().spawn(async move { original.load(&cancelled) });
+        self._loading = Some(cx.spawn(async move |this, cx| {
+            let result = work.await;
+            let _ = this.update(cx, |this, cx| {
+                match result {
+                    Ok((width, height, pixels)) => {
+                        if let Some(buffer) = image::RgbaImage::from_raw(width, height, pixels) {
+                            this.image = Arc::new(RenderImage::new(smallvec::smallvec![image::Frame::new(buffer)]));
+                            this.detail = Detail::Original;
+                            this.zoom = None;
+                            this.scroll.set_offset(point(px(0.0), px(0.0)));
+                        } else { this.detail = Detail::Unavailable; }
+                    }
+                    Err(_) => this.detail = Detail::Unavailable,
+                }
+                cx.notify();
+            });
+        }));
+    }
+
+    fn fit_zoom(&self, window: &Window) -> f32 {
+        let image = self.image.size(0);
+        let available = window.viewport_size();
+        let scale = window.scale_factor();
+        (f32::from(available.width) / (image.width.0 as f32 / scale))
+            .min((f32::from(available.height) - 34.0).max(1.0) / (image.height.0 as f32 / scale))
+            .max(0.001)
+    }
+
+    fn change_zoom(&mut self, action: Zoom, window: &Window, cx: &mut Context<Self>) {
+        let current = self.zoom.unwrap_or_else(|| self.fit_zoom(window));
+        self.zoom = match action {
+            Zoom::Fit => None,
+            Zoom::Actual => Some(1.0),
+            Zoom::In => Some((current * 1.25).clamp(0.01, 32.0)),
+            Zoom::Out => Some((current / 1.25).clamp(0.01, 32.0)),
+        };
+        self.scroll.set_offset(point(px(0.0), px(0.0)));
+        self.pan_start = None;
+        cx.notify();
+    }
+}
+
+impl Render for ImagePreview {
+    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let image_size = self.image.size(0);
+        let zoom = self.zoom.unwrap_or_else(|| self.fit_zoom(window));
+        let width = px(image_size.width.0 as f32 / window.scale_factor() * zoom);
+        let height = px(image_size.height.0 as f32 / window.scale_factor() * zoom);
+        let available = window.viewport_size();
+        let label = match self.detail {
+            Detail::Image => "Image", Detail::Loading => "Loading original…",
+            Detail::Original => "Original", Detail::Unavailable => "Original unavailable — showing preview",
+        };
+        let mode = self.zoom.map_or_else(|| "Fit".into(), |zoom| format!("{:.0}%", zoom * 100.0));
+        let status = format!("{label}  {} × {}  {mode}", image_size.width.0, image_size.height.0);
+        let button = |id: &'static str, label: &'static str, action: Zoom| div().id(id).px_2().py_1()
+            .rounded_sm().cursor_pointer().hover(|d| d.bg(crate::settings::color("hover")))
+            .on_click(cx.listener(move |this, _, window, cx| this.change_zoom(action, window, cx)))
+            .child(label);
+        let mut viewport = div().id("image-preview-scroll").flex_1().min_h(px(0.0)).w_full()
+            .overflow_scroll().track_scroll(&self.scroll)
+            .on_mouse_down(MouseButton::Left, cx.listener(|this, event: &MouseDownEvent, window, cx| {
+                this.focus.focus(window, cx);
+                this.pan_start = Some((event.position, this.scroll.offset()));
+                cx.stop_propagation();
+            }))
+            .on_mouse_move(cx.listener(|this, event: &MouseMoveEvent, _, cx| {
+                if event.pressed_button == Some(MouseButton::Left) {
+                    if let Some((start, offset)) = this.pan_start {
+                        this.scroll.set_offset(offset + (event.position - start));
+                        cx.notify();
+                    }
+                } else { this.pan_start = None; }
+            }))
+            .on_mouse_up(MouseButton::Left, cx.listener(|this, _, _, _| this.pan_start = None));
+        viewport.style().allow_concurrent_scroll = Some(true);
+        viewport.style().restrict_scroll_to_axis = Some(false);
+        div()
+            .flex().flex_col()
+            .size_full()
+            .bg(rgb(0x151515))
+            .track_focus(&self.focus)
+            .on_key_down(cx.listener(|this, event: &KeyDownEvent, window, cx| {
+                match event.keystroke.key.as_str() {
+                    "escape" => window.remove_window(),
+                    "0" => this.change_zoom(Zoom::Fit, window, cx),
+                    "1" => this.change_zoom(Zoom::Actual, window, cx),
+                    "+" | "=" => this.change_zoom(Zoom::In, window, cx),
+                    "-" => this.change_zoom(Zoom::Out, window, cx),
+                    _ => {},
+                }
+                cx.stop_propagation();
+            }))
+            .child(div().flex().items_center().h(px(34.0)).flex_shrink_0().px_2().text_xs()
+                .bg(crate::settings::color("popover")).text_color(crate::settings::color("foreground"))
+                .child(div().flex_1().child(status))
+                .child(button("zoom-out", "−", Zoom::Out))
+                .child(button("zoom-fit", "Fit", Zoom::Fit))
+                .child(button("zoom-actual", "100%", Zoom::Actual))
+                .child(button("zoom-in", "+", Zoom::In)))
+            .child(viewport
+                .child(div().flex().items_center().justify_center()
+                    .w(width.max(available.width)).h(height.max((available.height - px(34.0)).max(px(1.0))))
+                    .child(img(self.image.clone()).w(width).h(height).flex_shrink_0().object_fit(ObjectFit::Contain))))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::ImagePreview;
+    use crate::terminal::TerminalView;
