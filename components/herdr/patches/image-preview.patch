+use strict;
+use warnings;
+use JSON::PP;
+use Fcntl qw(:DEFAULT :mode);
+use Time::HiRes ();
+
+my ($mode, $path, $offset, $count, $expected) = @ARGV;
+sysopen(my $file, $path, O_RDONLY | O_NONBLOCK | O_NOFOLLOW)
+    or die "Cannot open image: $!\n";
+binmode($file);
+binmode(STDOUT);
+my @stat = Time::HiRes::stat($file);
+die "Not a regular image file\n" unless @stat && S_ISREG($stat[2]);
+die "Image file is empty or exceeds 32 MiB\n"
+    unless $stat[7] > 0 && $stat[7] <= 32 * 1024 * 1024;
+my $token = join(':', @stat[0, 1, 7, 9, 10]);
+if ($mode eq 'stat') {
+    print encode_json({ size => $stat[7], token => $token });
+    exit 0;
+}
+die "Invalid read request\n"
+    unless $mode eq 'read' && $offset =~ /^\d+$/ && $count =~ /^\d+$/
+    && $count <= 1024 * 1024 && $offset + $count <= $stat[7];
+die "Image changed while loading\n" unless $token eq $expected;
+defined(sysseek($file, $offset, 0)) or die "Cannot seek image: $!\n";
+my $bytes = '';
+while (length($bytes) < $count) {
+    my $read = sysread($file, $bytes, $count - length($bytes), length($bytes));
+    die "Cannot read image: $!\n" unless defined($read);
+    last unless $read;
+}
+@stat = Time::HiRes::stat($file);
+die "Image changed while loading\n"
+    unless length($bytes) == $count && join(':', @stat[0, 1, 7, 9, 10]) eq $token;
+print $bytes;
diff --git a/src/terminal/image_preview/original.rs b/src/terminal/image_preview/original.rs
