+        cx.run_until_parked();
+        let preview = cx.windows().into_iter().find_map(|w| w.downcast::<ImagePreview>()).unwrap();
+        preview.read_with(cx, |preview, _| {
+            assert_eq!(preview.detail, super::Detail::Original);
+            assert_eq!(preview.image.size(0), size(DevicePixels(3000), DevicePixels(2000)));
+            assert_eq!(&preview.image.as_bytes(0).unwrap()[..4], &[56, 34, 12, 255]);
+        }).unwrap();
+        let mut visual = VisualTestContext::from_window(preview.into(), cx);
+        visual.simulate_keystrokes("1");
+        visual.update(|window, cx| { window.simulate_next_frame(cx); window.draw(cx).clear(cx); });
+        visual.run_until_parked();
+        preview.read_with(cx, |preview, _| {
+            assert_eq!(preview.zoom, Some(1.0));
+            assert!(preview.scroll.max_offset().x > px(0.0));
+            assert!(preview.scroll.max_offset().y > px(0.0));
+        }).unwrap();
+        visual.simulate_event(ScrollWheelEvent {
+            position: point(px(200.0), px(200.0)),
+            delta: ScrollDelta::Pixels(point(px(-80.0), px(-60.0))),
+            ..Default::default()
+        });
+        visual.update(|window, cx| { window.simulate_next_frame(cx); window.draw(cx).clear(cx); });
+        visual.run_until_parked();
+        preview.read_with(cx, |preview, _| {
+            assert!(preview.scroll.offset().x < px(0.0));
+            assert!(preview.scroll.offset().y < px(0.0));
+        }).unwrap();
+        let before_drag = preview.read_with(cx, |preview, _| preview.scroll.offset()).unwrap();
+        visual.simulate_mouse_down(point(px(200.0), px(200.0)), MouseButton::Left, Modifiers::default());
+        visual.simulate_mouse_move(point(px(160.0), px(150.0)), Some(MouseButton::Left), Modifiers::default());
+        visual.simulate_mouse_up(point(px(160.0), px(150.0)), MouseButton::Left, Modifiers::default());
+        visual.run_until_parked();
+        preview.read_with(cx, |preview, _| {
+            assert!(preview.scroll.offset().x < before_drag.x);
+            assert!(preview.scroll.offset().y < before_drag.y);
+        }).unwrap();
+        visual.simulate_keystrokes("0 enter a escape");
+        cx.run_until_parked();
+        assert_eq!(cx.windows().len(), 1);
+        terminal.read_with(cx, |terminal, _| assert!(terminal.typed_at.get().is_none()));
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[gpui::test]
+    fn unavailable_original_keeps_the_preview_and_escape_still_closes_it(cx: &mut TestAppContext) {
+        use gpui::RenderImage;
+        use std::sync::Arc;
+
+        let stamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();
+        let path = std::env::temp_dir().join(format!("herdr-missing-original-{stamp}.png"));
+        let raw = path.to_string_lossy().replace('\\', "/").replace('%', "%25").replace(' ', "%20").replace('#', "%23");
+        let uri = format!("file://{}{raw}#codex-image-original", if cfg!(windows) { "/" } else { "" });
+        let source = super::OriginalSource::from_uri(&uri, None).unwrap_or_else(|| panic!("Invalid fixture URI: {uri}"));
+        cx.update(gpui_base::init);
+        let (_, cx) = cx.add_window_view(|_, cx| TerminalView::attach(crate::hc::offline(), "t1".into(), (40, 10), cx));
+        let image = Arc::new(RenderImage::new(smallvec::smallvec![image::Frame::new(
+            image::RgbaImage::from_pixel(2, 3, image::Rgba([0, 0, 255, 255])),
+        )]));
+        cx.update(|window, cx| super::open_original(image, Some(source), window, cx).unwrap());
+        cx.run_until_parked();
+        let preview = cx.windows().into_iter().find_map(|w| w.downcast::<ImagePreview>()).unwrap();
+        preview.read_with(cx, |preview, _| {
+            assert_eq!(preview.detail, super::Detail::Unavailable);
+            assert_eq!(preview.image.size(0), size(DevicePixels(2), DevicePixels(3)));
+        }).unwrap();
+        let mut visual = VisualTestContext::from_window(preview.into(), cx);
+        visual.simulate_keystrokes("escape");
+        cx.run_until_parked();
+        assert_eq!(cx.windows().len(), 1);
+    }
+}
