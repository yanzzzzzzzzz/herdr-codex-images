index 0000000..8227f3e
--- /dev/null
+++ b/src/terminal/image_preview/original.rs
@@ -0,0 +1,166 @@
+//! Resolve the explicit Codex image reference and read only after a person clicks it.
+
+use anyhow::{Context as _, Result, bail};
+use image::ImageDecoder as _;
+use serde::Deserialize;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+
+const MAX_FILE: usize = 32 * 1024 * 1024;
+const CHUNK: usize = 1024 * 1024;
+const READER: &str = include_str!("original-read.pl");
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(in crate::terminal) struct OriginalSource {
+    path: PathBuf,
+    machine: Option<String>,
+}
+
+impl OriginalSource {
+    pub(in crate::terminal) fn from_uri(uri: &str, machine: Option<String>) -> Option<Self> {
+        let uri = uri.strip_suffix("#codex-image-original")?;
+        if uri.len() > 8192 || uri.contains(['?', '#']) { return None; }
+        let path = crate::links::file_url_path(uri)?;
+        let text = path.to_str()?;
+        if text.chars().any(char::is_control) || text.starts_with("//") || text.starts_with(r"\\") {
+            return None;
+        }
+        let extension = path.extension()?.to_str()?.to_ascii_lowercase();
+        if !["png", "jpg", "jpeg", "webp", "gif", "bmp", "tif", "tiff"].contains(&extension.as_str()) {
+            return None;
+        }
+        if machine.is_some() {
+            // This reader targets the connected Unix machine, never a file on this computer.
+            if !text.starts_with('/') { return None; }
+        } else if !path.is_absolute() {
+            return None;
+        }
+        Some(Self { path, machine })
+    }
+
+    pub(super) fn load(&self, cancelled: &AtomicBool) -> Result<(u32, u32, Vec<u8>)> {
+        let bytes = match &self.machine {
+            Some(machine) => self.read_remote(machine, cancelled)?,
+            None => read_local(&self.path)?,
+        };
+        if cancelled.load(Ordering::Relaxed) { bail!("Preview closed"); }
+        decode(&bytes)
+    }
+
+    fn read_remote(&self, machine: &str, cancelled: &AtomicBool) -> Result<Vec<u8>> {
+        #[derive(Deserialize)]
+        struct Metadata { size: usize, token: String }
+        let run = |mode: &str, offset: usize, count: usize, token: &str| -> Result<Vec<u8>> {
+            if cancelled.load(Ordering::Relaxed) { bail!("Preview closed"); }
+            let args = vec!["-e".into(), READER.into(), "--".into(), mode.into(),
+                self.path.to_string_lossy().into_owned(), offset.to_string(), count.to_string(), token.into()];
+            let (code, stdout, stderr) = crate::mods::run_remote(machine, "/usr/bin/perl", &args, None)
+                .map_err(anyhow::Error::msg)?;
+            if code != 0 { bail!("{}", String::from_utf8_lossy(&stderr).trim()); }
+            Ok(stdout)
+        };
+        let metadata: Metadata = serde_json::from_slice(&run("stat", 0, 0, "")?)?;
+        if metadata.size == 0 || metadata.size > MAX_FILE { bail!("Image exceeds the preview limit"); }
+        let mut bytes = Vec::with_capacity(metadata.size);
+        while bytes.len() < metadata.size {
+            let count = CHUNK.min(metadata.size - bytes.len());
+            let chunk = run("read", bytes.len(), count, &metadata.token)?;
+            if chunk.len() != count { bail!("Incomplete original image"); }
+            bytes.extend_from_slice(&chunk);
+        }
+        Ok(bytes)
+    }
+}
+
+fn read_local(path: &Path) -> Result<Vec<u8>> {
+    let before = std::fs::symlink_metadata(path)?;
+    if !before.is_file() || before.len() == 0 || before.len() > MAX_FILE as u64 {
+        bail!("Original image is not a bounded regular file");
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt as _;
+        use std::path::{Component, Prefix};
+        if !matches!(path.components().next(), Some(Component::Prefix(prefix))
+            if matches!(prefix.kind(), Prefix::Disk(_) | Prefix::VerbatimDisk(_))) {
+            bail!("Only local image files are supported");
+        }
+        // Do not follow a junction or cloud placeholder into another computer's share.
+        for ancestor in path.ancestors().collect::<Vec<_>>().into_iter().rev() {
+            if std::fs::symlink_metadata(ancestor)?.file_attributes() & 0x400 != 0 {
+                bail!("Linked image paths are not supported");
+            }
+        }
+    }
+    let file = std::fs::File::open(path).context("Cannot open original image")?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() || metadata.len() == 0 || metadata.len() > MAX_FILE as u64 {
+        bail!("Original image is not a bounded regular file");
+    }
+    let mut bytes = Vec::with_capacity(metadata.len() as usize);
+    file.take(MAX_FILE as u64 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > MAX_FILE { bail!("Original image grew while loading"); }
+    Ok(bytes)
+}
+
+fn decode(bytes: &[u8]) -> Result<(u32, u32, Vec<u8>)> {
+    let mut limits = image::Limits::default();
+    limits.max_alloc = Some(64 * 1024 * 1024);
+    let mut reader = image::ImageReader::new(std::io::Cursor::new(bytes)).with_guessed_format()?;
+    reader.limits(limits.clone());
+    let mut decoder = reader.into_decoder()?;
+    limits.reserve(decoder.total_bytes())?;
+    decoder.set_limits(limits)?;
+    let orientation = decoder.orientation().ok();
+    let mut image = image::DynamicImage::from_decoder(decoder)?;
+    if let Some(orientation) = orientation { image.apply_orientation(orientation); }
+    let (width, height) = (image.width(), image.height());
+    if u64::from(width) * u64::from(height) * 4 > 64 * 1024 * 1024 {
+        bail!("Decoded image exceeds the preview limit");
+    }
+    let mut bgra = image.into_rgba8().into_raw();
+    for pixel in bgra.chunks_exact_mut(4) { pixel.swap(0, 2); }
+    Ok((width, height, bgra))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{OriginalSource, decode};
+
+    #[test]
+    fn original_references_are_explicit_local_raster_paths() {
+        let source = OriginalSource::from_uri("file:///Users/example/original%20%231.png#codex-image-original", Some("mac".into())).unwrap();
+        assert_eq!(source.path.to_str().unwrap(), "/Users/example/original #1.png");
+        assert_eq!(source.machine.as_deref(), Some("mac"));
+        for uri in ["https://example.com/image.png#codex-image-original", "file://server/share/image.png#codex-image-original",
+            "file:///Users/example/image.svg#codex-image-original", "file:///Users/example/image.png", "file:///Users/example/image%00.png#codex-image-original",
+            "file:////server/share/image.png#codex-image-original"] {
+            assert!(OriginalSource::from_uri(uri, Some("mac".into())).is_none(), "{uri}");
+        }
+    }
+
+    #[test]
+    fn original_decode_retains_resolution_and_converts_gpu_channels() {
+        let image = image::RgbaImage::from_pixel(2048, 1024, image::Rgba([12, 34, 56, 255]));
+        let mut png = std::io::Cursor::new(Vec::new());
+        image::DynamicImage::ImageRgba8(image).write_to(&mut png, image::ImageFormat::Png).unwrap();
+        let (width, height, bgra) = decode(png.get_ref()).unwrap();
+        assert_eq!((width, height), (2048, 1024));
+        assert_eq!(&bgra[..4], &[56, 34, 12, 255]);
+        assert!(decode(b"not an image").is_err());
+    }
+
+    #[test]
+    #[ignore = "requires the configured remote Mac and the task-owned image fixture"]
+    fn remote_original_matches_the_local_fixture_pixel_for_pixel() {
+        let machine = std::env::var("HERDR_PREVIEW_REMOTE_TEST_MACHINE").unwrap();
+        let uri = std::env::var("HERDR_PREVIEW_REMOTE_TEST_URI").unwrap();
+        let local = std::env::var("HERDR_PREVIEW_LOCAL_TEST_FILE").unwrap();
+        let expected = decode(&std::fs::read(local).unwrap()).unwrap();
+        let source = OriginalSource::from_uri(&uri, Some(machine)).unwrap();
+        let actual = source.load(&std::sync::atomic::AtomicBool::new(false)).unwrap();
+        assert_eq!((actual.0, actual.1), (2048, 1024));
+        assert_eq!(actual, expected, "the original lost pixels or changed during remote transfer");
+    }
+}
